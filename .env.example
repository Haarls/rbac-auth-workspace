# Neon Serverless PostgreSQL (recommended) or local Docker PostgreSQL
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local Docker Compose fallback:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rbac_workspace"

# Minimum 32-character secret for HS256 session JWT signing
AUTH_SECRET="replace-with-at-least-32-bytes-of-random-hex-secret"

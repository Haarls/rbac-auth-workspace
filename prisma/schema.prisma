generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model Sandbox {
  id        String     @id @default(cuid())
  ipHash    String
  createdAt DateTime   @default(now())
  expiresAt DateTime
  users     User[]
  sessions  Session[]
  shiftLogs ShiftLog[]
  auditLogs AuditLog[]

  @@index([expiresAt])
  @@index([ipHash, createdAt])
}

model User {
  id             String     @id @default(cuid())
  sandboxId      String
  sandbox        Sandbox    @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  email          String
  name           String
  passwordHash   String
  pinHash        String?
  role           Role       @default(STAFF)
  pinFailedCount Int        @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime   @default(now())
  sessions       Session[]
  shiftLogs      ShiftLog[]
  actorAudits    AuditLog[] @relation("AuditActor")

  @@unique([sandboxId, email])
  @@index([sandboxId])
}

model Session {
  id        String    @id @default(cuid())
  sandboxId String
  sandbox   Sandbox   @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([sandboxId, userId, revokedAt])
}

model ShiftLog {
  id             String   @id @default(cuid())
  sandboxId      String
  sandbox        Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  station        String
  summary        String
  cashDeltaCents Int
  status         String   @default("OPEN")
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([sandboxId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  sandboxId  String
  sandbox    Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  actorId    String?
  actorEmail String
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  target     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([sandboxId, action, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String
  pinHash        String?
  role           Role       @default(STAFF)
  pinFailedCount Int        @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime   @default(now())
  sessions       Session[]
  shiftLogs      ShiftLog[]
  actorAudits    AuditLog[] @relation("AuditActor")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
}

model ShiftLog {
  id             String   @id @default(cuid())
  station        String
  summary        String
  cashDeltaCents Int
  status         String   @default("OPEN")
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  target     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}
